{
  "native_netconf": {
    "policy": {
      "class-map": [
        {
          "@xmlns": "http://cisco.com/ns/yang/Cisco-IOS-XE-policy",
          "name": "VOICE",
          "prematch": "match-any",
          "match": {
            "protocol": {
              "protocols-list": {
                "protocols": "rtp audio"
              }
            }
          }
        },
        {
          "@xmlns": "http://cisco.com/ns/yang/Cisco-IOS-XE-policy",
          "name": "WEB",
          "prematch": "match-all",
          "match": {
            "protocol": {
              "protocols-list": {
                "protocols": "http"
              }
            }
          }
        }
      ],
      "policy-map": {
        "@xmlns": "http://cisco.com/ns/yang/Cisco-IOS-XE-policy",
        "name": "WAN-QOS",
        "class": [
          {
            "name": "VOICE",
            "action-list": {
              "action-type": "priority",
              "priority": {
                "kilo-bits": "1000"
              }
            }
          },
          {
            "name": "WEB",
            "action-list": {
              "action-type": "bandwidth",
              "bandwidth": {
                "bits": "5000"
              }
            }
          }
        ]
      }
    },
    "interface": {
      "GigabitEthernet": [
        {
          "name": "1",
          "logging": {
            "event": {
              "link-status": null
            }
          },
          "mop": {
            "enabled": "false",
            "sysid": "false"
          },
          "negotiation": {
            "@xmlns": "http://cisco.com/ns/yang/Cisco-IOS-XE-ethernet",
            "auto": "true"
          },
          "service-policy": {
            "@xmlns": "http://cisco.com/ns/yang/Cisco-IOS-XE-policy",
            "output": "WAN-QOS"
          }
        },
        {
          "name": "1.98",
          "encapsulation": {
            "dot1Q": {
              "vlan-id": "98",
              "native": null
            }
          },
          "ip": {
            "address": {
              "primary": {
                "address": "192.168.255.20",
                "mask": "255.255.255.0"
              }
            }
          }
        },
        {
          "name": "2",
          "shutdown": null,
          "logging": {
            "event": {
              "link-status": null
            }
          },
          "mop": {
            "enabled": "false",
            "sysid": "false"
          },
          "negotiation": {
            "@xmlns": "http://cisco.com/ns/yang/Cisco-IOS-XE-ethernet",
            "auto": "true"
          }
        },
        {
          "name": "3",
          "shutdown": null,
          "logging": {
            "event": {
              "link-status": null
            }
          },
          "mop": {
            "enabled": "false",
            "sysid": "false"
          },
          "negotiation": {
            "@xmlns": "http://cisco.com/ns/yang/Cisco-IOS-XE-ethernet",
            "auto": "true"
          }
        },
        {
          "name": "4",
          "shutdown": null,
          "logging": {
            "event": {
              "link-status": null
            }
          },
          "mop": {
            "enabled": "false",
            "sysid": "false"
          },
          "negotiation": {
            "@xmlns": "http://cisco.com/ns/yang/Cisco-IOS-XE-ethernet",
            "auto": "true"
          }
        }
      ]
    }
  }
}