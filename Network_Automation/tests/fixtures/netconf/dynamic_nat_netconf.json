{
  "native_netconf": {
    "ip": {
      "nat": {
        "@xmlns": "http://cisco.com/ns/yang/Cisco-IOS-XE-nat",
        "pool": [
          {
            "id": "BACKUP_POOL",
            "start-address": "210.1.1.100",
            "end-address": "210.1.1.110",
            "netmask": "255.255.255.0"
          },
          {
            "id": "INTERNET_POOL",
            "start-address": "200.1.1.100",
            "end-address": "200.1.1.110",
            "netmask": "255.255.255.0"
          }
        ],
        "inside": {
          "source": {
            "list": {
              "id": "10",
              "pool-with-vrf": {
                "pool": [
                    {"name": "INTERNET_POOL"},
                    {"name": "BACKUP_POOL"}
                ]
              }
            }
          }
        }
      },
      "interface": {
        "GigabitEthernet": [
          {
            "name": "1",
            "ip": {
              "nat": {
                "@xmlns": "http://cisco.com/ns/yang/Cisco-IOS-XE-nat",
                "outside": null
              }
            },
            "logging": {
              "event": {
                "link-status": null
              }
            },
            "mop": {
              "enabled": "false",
              "sysid": "false"
            },
            "negotiation": {
              "@xmlns": "http://cisco.com/ns/yang/Cisco-IOS-XE-ethernet",
              "auto": "true"
            },
            "service-policy": {
              "@xmlns": "http://cisco.com/ns/yang/Cisco-IOS-XE-policy",
              "output": "WAN-QOS"
            }
          },
          {
            "name": "1.50",
            "encapsulation": {
              "dot1Q": {
                "vlan-id": "10"
              }
            },
            "standby": {
              "version": "2",
              "standby-list": {
                "group-number": "10",
                "ip": {
                  "address": "192.168.10.1"
                },
                "preempt": null,
                "priority": "110"
              }
            }
          },
          {
            "name": "1.98",
            "encapsulation": {
              "dot1Q": {
                "vlan-id": "98",
                "native": null
              }
            },
            "ip": {
              "address": {
                "primary": {
                  "address": "192.168.255.20",
                  "mask": "255.255.255.0"
                }
              }
            }
          },
          {
            "name": "2",
            "ip": {
              "nat": {
                "@xmlns": "http://cisco.com/ns/yang/Cisco-IOS-XE-nat",
                "outside": null
              }
            },
            "logging": {
              "event": {
                "link-status": null
              }
            },
            "mop": {
              "enabled": "false",
              "sysid": "false"
            },
            "negotiation": {
              "@xmlns": "http://cisco.com/ns/yang/Cisco-IOS-XE-ethernet",
              "auto": "true"
            }
          },
          {
            "name": "3",
            "shutdown": null,
            "ip": {
              "nat": {
                "@xmlns": "http://cisco.com/ns/yang/Cisco-IOS-XE-nat",
                "inside": null
              }
            },
            "logging": {
              "event": {
                "link-status": null
              }
            },
            "mop": {
              "enabled": "false",
              "sysid": "false"
            },
            "negotiation": {
              "@xmlns": "http://cisco.com/ns/yang/Cisco-IOS-XE-ethernet",
              "auto": "true"
            }
          }
        ]
      }
    }
  }
}